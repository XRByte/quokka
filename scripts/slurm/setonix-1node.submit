#!/bin/bash

#SBATCH -A pawsey0807-gpu
#SBATCH -J quokka_turbulence
#SBATCH -o 1node_%x-%j.out
#SBATCH -t 24:00:00
#SBATCH -p gpu
#SBATCH --exclusive
# 512^3 needs ~550 GB; 1 node = 8 GCDs x 64 GB = 512 GB HBM -> 2 nodes (16 GCDs, 1 TB)
#SBATCH -N 2
##SBATCH --ntasks-per-node=8
##SBATCH --gpus-per-node=8

# *MUST* load environment modules setup script inside the SLURM script, otherwise job will fail
. scripts/hpc_profiles/setonix-gpu.profile

# always run with GPU-aware MPI
export MPICH_GPU_SUPPORT_ENABLED=1

# use correct NIC-to-GPU binding
export MPICH_OFI_NIC_POLICY=NUMA

# OpenMP threads (pure MPI => 1)
# QUOKKA does not use OpenMP, but it's good practice on Setonix to avoid accidental thread oversubscription
export OMP_NUM_THREADS=1

## run
# executable target is ${JOB_NAME} = Turbulence; build with: quokka build -d 3d-hip Turbulence
EXE="build/3d-hip/src/problems/Turbulence/Turbulence"
INPUTS="inputs/Turbulence.toml"
N_CELL="512 512 512"
# 128^3 boxes -> 64 boxes over 16 GCDs (4 per GCD)
GRID_ARGS="amr.max_grid_size=128 amr.blocking_factor=32"
# 4 T total: 2 T hydro spin-up (turbchem.chem_start_time = 2 T in the toml) + 2 T chemistry
# T = L / (2 target_vdisp) = 1.928549e15 s
EXTRA_ARGS="stop_time=7.714196e15"
# Benchmark instead (chemistry from t = 0, 10 steps, no output; read "Performance figure-of-merit"):
# EXTRA_ARGS="turbchem.chem_start_time=0.0 max_timesteps=10 checkpoint_interval=-1 plottime_interval=-1"

# Restart automatically from the newest checkpoint (Quokka keeps the 'last_chk' symlink up to date).
# The run will need several 24 h jobs: chain them with  sbatch -d afterany:<previous jobid> <this script>.
# TurbGen.dat must stay in this directory, it holds the auto-adjusted driving amplitude.
RESTART_ARGS=""
if [ -e last_chk ]; then
	RESTART_ARGS="restartfile=last_chk"
	echo -e "\n# Restarting from $(readlink last_chk)"
fi

# GOW cooling tables are read from the working directory
ln -sf src/networks/GOW_nr/gow_cooling_tables.hdf5 .

# Wrapper that sets ROCR_VISIBLE_DEVICES per task
# Create it in the working directory
cat >selectGPU_X.sh <<'EOF'
#!/bin/bash
# Set the visible GPU for this task to its local task ID on the node
export ROCR_VISIBLE_DEVICES="$SLURM_LOCALID"
exec "$@"
EOF
chmod 755 ./selectGPU_X.sh

# Generate optimal CPU binding list for 8 tasks on the GPUs allocated to this job
CPU_BIND=$(generate_CPU_BIND.sh map_cpu)
echo -e "\n# CPU_BIND=${CPU_BIND}"

echo -e "\n# Run: 16 MPI tasks (2 nodes x 8 GCDs), manual GPU + CPU binding"
# Notes:
# -N 2, -n 16: 8 ranks per node, one per GCD
# -c 8: reserve one full chiplet per rank (actual threads controlled by OMP_NUM_THREADS)
# --gres=gpu:8: expose 8 GPUs per node to this step
# --cpu-bind=${CPU_BIND}: bind each rank to the chiplet matching its GPU
# No --gpus-per-task, no --gpu-bind (manual binding avoids ROCm IPC attach error)
srun -N 2 -n 16 -c 8 --gres=gpu:8 --cpu-bind=${CPU_BIND} ./selectGPU_X.sh ${EXE} ${INPUTS} amr.n_cell="${N_CELL}" ${GRID_ARGS} ${EXTRA_ARGS} ${RESTART_ARGS}

echo -e "\n# sacct summary"
sacct -j ${SLURM_JOBID} -o jobid%20,Start%20,elapsed%20
echo -e "\n# Done"
